# --- Quantern — variaveis de ambiente (servidor) ---
# Copiar para `.env` (nunca commitar o `.env`). Todas as chaves reais vivem
# AQUI, no servidor. O frontend (Vite) NUNCA le estas variaveis.

# --- Binance / Cripto ---
# Conta REAL (Fase 4). Enquanto BINANCE_LIVE_ENABLED nao for "true", o servidor
# responde 403 a /api/crypto/live/order e tudo corre em conta paper.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_LIVE_ENABLED=false
# Quando "true", o proxy de market-data (/api/binance/klines,
# /api/binance/ticker24h) usa a testnet de futures como fallback
# (https://testnet.binancefuture.com) se a API live falhar.
# BINANCE_TESTNET=true

# Defaults de Binance Futures (usados por GET /api/settings/binance-futures
# quando ainda nao existe config persistida em data/binance_futures.json.
# O POST /api/settings/binance-futures valida leverage 1-125 e persiste
# apenas flags — nunca guarda API key/secret).
# BINANCE_DEFAULT_LEVERAGE=10
# BINANCE_FUTURES_FEE=0.0004
# BINANCE_TRAILING_PCT=0.005

# Conta paper spot (Fases 2-3): saldo inicial em USDT e taxa por lado.
# CRYPTO_PAPER_START_USDT=10000
# CRYPTO_SPOT_FEE=0.001
